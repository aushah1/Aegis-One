PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URL=mongodb://localhost:27017/audit
REDIS_URL=redis://localhost:6379

# Google PageSpeed Insights key (free): console.cloud.google.com -> enable "PageSpeed Insights API"
PSI_API_KEY=

# Gemini key (free): aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Which AI providers to try, in order (comma-separated). Falls through to the next on failure.
AI_PROVIDERS=gemini

# Groq key (free, no credit card): console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
